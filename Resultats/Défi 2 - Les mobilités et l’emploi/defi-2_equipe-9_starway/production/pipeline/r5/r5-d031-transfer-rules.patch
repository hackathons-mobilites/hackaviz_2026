@@ -0,0 +1,67 @@
+package com.conveyal.r5.profile;
+
+/**
+ * STARWAY (D-031) : temps de correspondance minimum au meme arret, apres une arrivee en transport en commun.
+ *
+ * R5 d'origine accepte une montee strictement plus de 60 s apres l'arrivee a l'arret (MINIMUM_BOARD_WAIT_SEC de
+ * FastRaptorWorker, BOARD_SLACK de McRaptorSuboptimalPathProfileRouter), quel que soit l'arret. Le calculateur
+ * officiel IDFM (Navitia, API PRIM "connections") applique au meme arret une duree propre a chaque arret (120, 300 ou
+ * 900 s). Le pipeline STARWAY charge ces durees, une par index d'arret R5, avant tout calcul ; un arret sans duree
+ * relevee (valeur 0) garde la regle d'origine. La regle ne s'applique qu'a une arrivee en transport en commun a cet
+ * arret : un acces a pied ou une correspondance a pied depuis un autre arret garde la regle d'origine (les minimums
+ * entre arrets differents viennent de transfers.txt, charges dans TransitLayer.gtfsTransfers).
+ *
+ * Semantique : avec une duree D pour l'arret, un depart a l'heure d est accepte apres une arrivee a l'heure a si
+ * d >= a + D, c'est-a-dire d > a + (D - 1). Le resultat n'est jamais plus permissif que la regle d'origine.
+ */
+public final class StarwayTransferRules {
+
+    /** Version du correctif STARWAY, verifiee par le pipeline dans le jar et dans la JVM. */
+    public static final int STARWAY_TRANSFER_RULES_VERSION = 1;
+
+    /** Duree minimum (s) au meme arret, par index d'arret R5 ; 0 = regle d'origine ; null = aucune duree chargee. */
+    private static volatile int[] sameStopMinSeconds = null;
+
+    private StarwayTransferRules () { }
+
+    public static void setSameStopMinSeconds (int[] values) {
+        sameStopMinSeconds = values == null ? null : values.clone();
+    }
+
+    /** Nombre d'arrets avec une duree chargee (controle du pipeline). */
+    public static int loadedStopCount () {
+        int[] m = sameStopMinSeconds;
+        if (m == null) return 0;
+        int n = 0;
+        for (int v : m) if (v > 0) n++;
+        return n;
+    }
+
+    /** Duree chargee pour un arret (0 si aucune). */
+    public static int sameStopMinSeconds (int stop) {
+        int[] m = sameStopMinSeconds;
+        return (m == null || stop < 0 || stop >= m.length) ? 0 : m[stop];
+    }
+
+    /**
+     * Attente minimum (s) avant une montee, au sens de R5 (le depart doit etre strictement posterieur a
+     * arrivee + attente). Apres une arrivee en transport en commun a un arret qui a une duree D : max(defaut, D - 1).
+     */
+    public static int boardSlack (int stop, boolean arrivedByTransitHere, int defaultSlack) {
+        if (!arrivedByTransitHere) return defaultSlack;
+        int d = sameStopMinSeconds(stop);
+        return d > 0 ? Math.max(defaultSlack, d - 1) : defaultSlack;
+    }
+
+    /**
+     * FastRaptorWorker : heure apres laquelle un depart peut etre pris a `stop` dans le tour suivant. La meilleure heure
+     * de l'arret est une arrivee en transport en commun a cet arret si elle est egale a la meilleure arrivee sans
+     * correspondance (sinon elle vient d'un acces ou d'une correspondance a pied depuis un autre arret).
+     */
+    public static int earliestBoardTime (RaptorState inputState, int stop, int defaultSlack) {
+        int best = inputState.bestTimes[stop];
+        int nonTransfer = inputState.bestNonTransferTimes[stop];
+        boolean byTransit = inputState.previous != null && nonTransfer != FastRaptorWorker.UNREACHED && nonTransfer == best;
+        return best + boardSlack(stop, byTransit, defaultSlack);
+    }
+}
