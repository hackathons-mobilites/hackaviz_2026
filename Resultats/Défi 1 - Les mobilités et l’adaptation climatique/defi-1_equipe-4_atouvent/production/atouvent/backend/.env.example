# Copier en .env puis remplir. Ne jamais versionner .env.
# Base
MONGO_URI=mongodb://localhost:27017
MONGO_DB=atouvent
# En local : http://localhost:5174 · en ligne : https://atouvent.com (l'APK Android appelle depuis https://localhost)
CORS_ORIGINS=https://atouvent.com,https://localhost,capacitor://localhost
# Adresse publique de l'application (liens dans les e-mails)
# Adresse du site (liens envoyés par e-mail) ; en HTTPS, le cookie de session devient « Secure »
APP_URL=https://atouvent.com
# 1 derrière un proxy inverse (nginx, Caddy) pour lire l'IP réelle
TRUST_PROXY=0
# 1 pour activer /docs (à laisser à 0 en production)
ENABLE_DOCS=0

# Secrets OBLIGATOIRES : l'API refuse de démarrer sans eux
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROFILE_ENCRYPTION_KEY=

# E-mails (465 = SSL ; pour 587 mettre SMTP_SSL=0)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Adresses e-mail des super admins (séparées par des virgules)
SUPERADMIN_EMAILS=

# Ascenseurs IDFM : jeu en accès restreint, clé API du portail data.iledefrance-mobilites.fr
IDFM_API_KEY=

# PRIM (prim.iledefrance-mobilites.fr), quota du jeton à vérifier dans « My API Usage »
PRIM_API_KEY=
# Vigilance officielle Météo-France (facultatif) : https://portail-api.meteofrance.fr > API « Données Publiques Vigilance »
METEOFRANCE_API_KEY=
PRIM_DAILY_QUOTA=1000
PRIM_PER_SECOND=5

# Itinéraires : calculateur intégré sur le GTFS IDFM (python -m app.router.build IDFM-gtfs.zip)
# OTP_URL facultatif : OpenTripPlanner auto-hébergé, prioritaire s'il est renseigné
OTP_URL=
