# Copier en keystore.properties (ignoré par git) et remplir. La clé se crée une seule fois :
#   keytool -genkeypair -v -keystore atouvent-release.jks -alias atouvent -keyalg RSA -keysize 2048 -validity 10000
# Garder le fichier .jks et ses mots de passe en lieu sûr : sans eux, plus de mise à jour possible sur le Play Store.
storeFile=atouvent-release.jks
storePassword=
keyAlias=atouvent
keyPassword=
